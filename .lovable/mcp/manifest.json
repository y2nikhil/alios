{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qpixarrajdoozxnmebqa.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "classlab",
      "version": "0.1.0",
      "title": "ClassLab"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in student's ClassLab tasks, newest first, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Only return tasks with this status.",
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "cancelled",
                "pending",
                "overdue"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of tasks to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a new study task for the signed-in student in ClassLab.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short task title."
            },
            "description": {
              "description": "Optional task details.",
              "type": "string",
              "maxLength": 2000
            },
            "due_at": {
              "description": "Optional ISO 8601 due date/time.",
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "priority": {
              "description": "Priority, 0 = lowest.",
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_task_status",
        "title": "Update task status",
        "description": "Change the status of one of the signed-in student's ClassLab tasks (e.g. mark it done).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The task id."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "cancelled",
                "pending",
                "overdue"
              ],
              "description": "New status for the task."
            }
          },
          "required": [
            "task_id",
            "status"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_feed_posts",
        "title": "Search feed posts",
        "description": "Search recent ClassLab community feed posts by keyword or tag.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Keyword to match in post titles and bodies.",
              "type": "string",
              "maxLength": 120
            },
            "tag": {
              "description": "Only return posts with this tag.",
              "type": "string",
              "maxLength": 60
            },
            "limit": {
              "default": 10,
              "description": "Maximum number of posts to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_focus_summary",
        "title": "Get focus summary",
        "description": "Summarise the signed-in student's tracked focus sessions over a recent number of days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "days": {
              "default": 7,
              "description": "How many days back to summarise.",
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_post",
        "title": "Create feed post",
        "description": "Publish a new post to the ClassLab community feed as the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Post title."
            },
            "body": {
              "description": "Post body (markdown allowed).",
              "type": "string",
              "maxLength": 20000
            },
            "tag": {
              "description": "Optional topic tag.",
              "type": "string",
              "maxLength": 60
            },
            "media_url": {
              "description": "Optional image or video URL.",
              "type": "string",
              "format": "uri"
            },
            "media_kind": {
              "description": "Kind of attached media.",
              "type": "string",
              "enum": [
                "image",
                "video"
              ]
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_comment",
        "title": "Comment on a post",
        "description": "Add a comment (or a threaded reply) to a ClassLab feed post as the signed-in user. Accepts a post id or slug.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "post": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Post UUID or slug."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "description": "Comment text."
            },
            "parent_id": {
              "description": "Optional parent comment id to reply to.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "post",
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_post_comments",
        "title": "List comments on a post",
        "description": "Read the comment thread of a ClassLab feed post by id or slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "post": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Post UUID or slug."
            },
            "limit": {
              "default": 50,
              "description": "Maximum comments to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "post"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "vote_post",
        "title": "Vote on a post",
        "description": "Upvote, downvote, or clear the signed-in user's vote on a ClassLab feed post.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "post_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Post UUID."
            },
            "value": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "clear"
              ],
              "description": "Vote direction, or 'clear' to remove."
            }
          },
          "required": [
            "post_id",
            "value"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_blog_post",
        "title": "Create blog post",
        "description": "Create a ClassLab blog article (markdown body) as a draft or published. Requires an admin account.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Article title."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "description": "Full markdown body of the article."
            },
            "excerpt": {
              "description": "Short summary shown in listings.",
              "type": "string",
              "maxLength": 500
            },
            "slug": {
              "description": "URL slug; derived from the title when omitted.",
              "type": "string",
              "maxLength": 120
            },
            "tags": {
              "description": "Topic tags.",
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            },
            "status": {
              "default": "draft",
              "description": "Publish immediately or keep as draft.",
              "type": "string",
              "enum": [
                "draft",
                "published"
              ]
            },
            "cover_url": {
              "description": "Optional cover image URL.",
              "type": "string",
              "format": "uri"
            },
            "cover_alt": {
              "description": "Alt text for the cover image.",
              "type": "string",
              "maxLength": 200
            },
            "seo_title": {
              "description": "SEO title override.",
              "type": "string",
              "maxLength": 120
            },
            "seo_description": {
              "description": "Meta description.",
              "type": "string",
              "maxLength": 200
            },
            "keywords": {
              "description": "Comma-separated SEO keywords.",
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "title",
            "content"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_blog_post",
        "title": "Update or publish blog post",
        "description": "Edit an existing ClassLab blog article or change its status (draft/published). Requires an admin account.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "description": "Blog post UUID (or provide slug).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "slug": {
              "description": "Existing slug of the article.",
              "type": "string",
              "maxLength": 120
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "content": {
              "description": "Replacement markdown body.",
              "type": "string"
            },
            "excerpt": {
              "type": "string",
              "maxLength": 500
            },
            "tags": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published"
              ]
            },
            "cover_url": {
              "type": "string",
              "format": "uri"
            },
            "seo_title": {
              "type": "string",
              "maxLength": 120
            },
            "seo_description": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_blog_posts",
        "title": "List blog posts",
        "description": "List ClassLab blog articles, optionally filtered by status or keyword.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "default": "published",
              "description": "Filter by status.",
              "type": "string",
              "enum": [
                "draft",
                "published",
                "any"
              ]
            },
            "query": {
              "description": "Keyword to match in title or excerpt.",
              "type": "string",
              "maxLength": 120
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of articles.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
